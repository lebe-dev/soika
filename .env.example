# soika backend configuration.
#
# Copy this file to `.env` and adjust the values. The `.env` file is loaded
# automatically by the Justfile (`set dotenv-load := true`) when you run
# `just run`. All values below are optional except SECRET_KEY.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Display name of the single organization shown in the UI.
# Default: soika
ORGANIZATION_NAME=soika

# IANA timezone name used by the UI to display timestamps (e.g. Europe/Moscow,
# America/New_York). The backend always stores dates in UTC; this only affects
# how they are shown to users. Must be a valid IANA zone identifier.
# Default: UTC
# TIMEZONE=Europe/Moscow

# sqlx connection string. The SQLite file is created automatically if missing.
# Default: sqlite://soika.db
DATABASE_URL=sqlite://data/soika.db

# Address the HTTP server binds to (host:port).
# Default: 0.0.0.0:8080
BIND_ADDR=127.0.0.1:8080

# Public base URL used in emails, invite links, and event DSNs. Set this to the
# externally reachable URL when running behind a proxy or in production.
# Default: http://localhost:8080
BASE_URL=http://localhost:8080

# REQUIRED. Secret used to sign session cookies and invite tokens. Must be a
# non-empty string; use a long random value in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

# Whether public self-registration is enabled. Accepts: 1/true/yes/on (else false).
# Default: false
ALLOW_SIGNUP=false

# The built-in administrator is no longer configured via env vars. On first run
# the service is uninitialized and the web UI redirects to /setup, where you
# create the instance admin (stored in the database). Once an admin exists,
# /setup is closed and redirects to the login form.

# ---------------------------------------------------------------------------
# Login brute-force protection
# ---------------------------------------------------------------------------
# Password logins (and password-based invite acceptance) are throttled per
# (client IP, email). After LOGIN_MAX_ATTEMPTS failures within
# LOGIN_LOCKOUT_WINDOW_SECS the key is locked; each repeated lockout grows
# exponentially from LOGIN_LOCKOUT_BASE_SECS up to LOGIN_LOCKOUT_MAX_SECS. A
# successful login clears the key. The client IP is read from X-Forwarded-For /
# X-Real-IP (set these on your reverse proxy), falling back to the socket peer.
# State is in-memory and per-instance (reset on restart, not shared across
# replicas).

# Master switch. Accepts: 1/true/yes/on (else false).
# Default: true
# LOGIN_LOCKOUT_ENABLED=true

# Failed attempts within the window that trigger a lockout.
# Default: 5
# LOGIN_MAX_ATTEMPTS=5

# Rolling window (seconds) over which failures accumulate.
# Default: 900 (15 minutes)
# LOGIN_LOCKOUT_WINDOW_SECS=900

# First lockout duration (seconds); doubles on each successive lockout.
# Default: 60
# LOGIN_LOCKOUT_BASE_SECS=60

# Upper bound (seconds) on the exponential lockout. Must be >= base.
# Default: 3600 (1 hour)
# LOGIN_LOCKOUT_MAX_SECS=3600

# ---------------------------------------------------------------------------
# Event retention
# ---------------------------------------------------------------------------

# Default maximum number of stored events kept per project.
# Default: 1000
DEFAULT_EVENTS_RETENTION=1000

# Cron schedule (6-field, with seconds) for the retention cleanup job.
# Default: every 15 minutes
RETENTION_CRON="0 */15 * * * *"

# ---------------------------------------------------------------------------
# SMTP (optional)
# ---------------------------------------------------------------------------
# Email features degrade gracefully to UI-only when SMTP_HOST is unset.

# SMTP server hostname. Setting this enables outgoing email.
# SMTP_HOST=smtp.example.com

# SMTP server port.
# Default: 587
# SMTP_PORT=587

# Whether to encrypt the connection. When true (default) soika uses implicit TLS
# on port 465 and STARTTLS on every other port. Set to false ONLY for local,
# trusted relays without TLS support (e.g. mailcrab / MailHog on a dev stand) —
# the connection is then plaintext. Accepts: 1/true/yes/on (else false).
# Default: true
# SMTP_TLS=false

# Optional SMTP credentials.
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Sender address used in the From header of outgoing emails.
# SMTP_FROM=soika@example.com

# ---------------------------------------------------------------------------
# OAuth / OIDC (optional)
# ---------------------------------------------------------------------------
# Two provider flavours, selected by OAUTH_PROVIDER:
#   * oidc   (default) — any generic OpenID Connect provider via discovery
#                        (GitLab, Keycloak, Authentik, Google, Okta, Entra, ...).
#                        Requires OAUTH_ISSUER_URL.
#   * github           — GitHub OAuth Apps. GitHub is NOT an OIDC provider (no
#                        discovery document, no ID-token), so it uses a dedicated
#                        OAuth2 flow that reads identity from the GitHub REST API.
#                        OAUTH_ISSUER_URL is not needed.
#
# Disabled by default; when disabled, password login is unchanged. When enabled,
# OAUTH_CLIENT_ID/CLIENT_SECRET are always required (plus OAUTH_ISSUER_URL for the
# oidc flavour); the server fails fast at startup if a required value is missing.
#
# Requires BASE_URL to use https:// in production so session/state cookies are
# marked Secure. Register the redirect URI below with your provider.

# Master switch. Accepts: 1/true/yes/on (else false).
# Default: false
# OAUTH_ENABLED=true

# Provider flavour: oidc (default) or github.
# OAUTH_PROVIDER=oidc

# Issuer base URL for OIDC discovery ({issuer}/.well-known/openid-configuration).
# Required for OAUTH_PROVIDER=oidc; ignored for github.
# OAUTH_ISSUER_URL=https://gitlab.com

# Application credentials registered with the provider.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# Redirect URI; must match the provider configuration.
# Default: {BASE_URL}/auth/oidc/callback
# OAUTH_REDIRECT_URL=https://errors.example.com/auth/oidc/callback

# Space-separated OAuth scopes.
# Default: "openid email profile" for oidc, "read:user user:email" for github.
# OAUTH_SCOPES=openid email profile

# Label shown on the SSO button ("Sign in with {name}").
# Default: SSO
# OAUTH_PROVIDER_NAME=GitLab

# Optional comma-separated whitelist of email domains allowed to auto-provision.
# Empty = any domain.
# OAUTH_ALLOWED_EMAIL_DOMAINS=example.com,itkey.com

# Require admin approval for new SSO accounts. When true, a user provisioned on
# their first SSO login lands in a `pending` status and receives NO session: they
# are shown an "awaiting approval" page until an instance admin approves the
# account from the admin UI (Admin > Users). Approving flips the account to
# active; rejecting deletes it. Existing accounts and local/password sign-ups are
# unaffected. Accepts: 1/true/yes/on (else false).
# Default: false
# OAUTH_REQUIRE_APPROVAL=true

# Example (GitLab.com — generic OIDC):
#   OAUTH_ENABLED=true
#   OAUTH_PROVIDER=oidc
#   OAUTH_ISSUER_URL=https://gitlab.com
#   OAUTH_CLIENT_ID=<from GitLab > User Settings > Applications>
#   OAUTH_CLIENT_SECRET=<from GitLab>
#   OAUTH_SCOPES=openid email profile
#   (Redirect URI in GitLab: {BASE_URL}/auth/oidc/callback)
#
# Example (GitHub — OAuth App, NOT OIDC):
#   OAUTH_ENABLED=true
#   OAUTH_PROVIDER=github
#   OAUTH_CLIENT_ID=<from GitHub > Settings > Developer settings > OAuth Apps>
#   OAUTH_CLIENT_SECRET=<from GitHub>
#   OAUTH_PROVIDER_NAME=GitHub
#   OAUTH_SCOPES=read:user user:email
#   (Authorization callback URL in GitHub: {BASE_URL}/auth/oidc/callback)

# ---------------------------------------------------------------------------
# Sentry error reporting (optional)
# ---------------------------------------------------------------------------
# Self-observability: report soika's own backend and frontend errors to a Sentry
# (or Sentry-compatible) instance. Disabled by default; setting SENTRY_DSN
# enables it. A single DSN is shared by both halves.
#
# The backend initializes the SDK at startup (panics + `tracing` error events).
# The frontend DSN is served only from the authenticated GET /api/client-config
# endpoint and the browser SDK initializes after sign-in, so the DSN never
# appears on an unauthenticated route (errors on the login page are not
# captured). Only error reporting is enabled — no performance tracing.
#
# Note: the release build uses panic=abort, so a panic event is best-effort and
# may not flush before the process exits; `tracing::error!` events are reliable.

# Sentry DSN both halves report to. Setting this enables error reporting.
# SENTRY_DSN=https://<key>@sentry.example.com/<project>

# Optional environment tag attached to events (e.g. production / staging).
# Unset leaves it at Sentry's default.
# SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# tracing/env-filter directive controlling log verbosity.
# Default: info,soika=debug
RUST_LOG=info,soika=debug
