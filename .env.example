# soika backend configuration.
#
# Copy this file to `.env` and adjust the values. The `.env` file is loaded
# automatically by the Justfile (`set dotenv-load := true`) when you run
# `just run`. All values below are optional except SECRET_KEY.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Display name of the single organization shown in the UI.
# Default: soika
ORGANIZATION_NAME=soika

# sqlx connection string. The SQLite file is created automatically if missing.
# Default: sqlite://soika.db
DATABASE_URL=sqlite://data/soika.db

# Address the HTTP server binds to (host:port).
# Default: 0.0.0.0:8080
BIND_ADDR=127.0.0.1:8080

# Public base URL used in emails, invite links, and event DSNs. Set this to the
# externally reachable URL when running behind a proxy or in production.
# Default: http://localhost:8080
BASE_URL=http://localhost:8080

# REQUIRED. Secret used to sign session cookies and invite tokens. Must be a
# non-empty string; use a long random value in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

# Whether public self-registration is enabled. Accepts: 1/true/yes/on (else false).
# Default: false
ALLOW_SIGNUP=false

# The built-in administrator is no longer configured via env vars. On first run
# the service is uninitialized and the web UI redirects to /setup, where you
# create the instance admin (stored in the database). Once an admin exists,
# /setup is closed and redirects to the login form.

# ---------------------------------------------------------------------------
# Event retention
# ---------------------------------------------------------------------------

# Default maximum number of stored events kept per project.
# Default: 1000
DEFAULT_EVENTS_RETENTION=1000

# Cron schedule (6-field, with seconds) for the retention cleanup job.
# Default: every 15 minutes
RETENTION_CRON="0 */15 * * * *"

# ---------------------------------------------------------------------------
# SMTP (optional)
# ---------------------------------------------------------------------------
# Email features degrade gracefully to UI-only when SMTP_HOST is unset.

# SMTP server hostname. Setting this enables outgoing email.
# SMTP_HOST=smtp.example.com

# SMTP server port.
# Default: 587
# SMTP_PORT=587

# Optional SMTP credentials.
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Sender address used in the From header of outgoing emails.
# SMTP_FROM=soika@example.com

# ---------------------------------------------------------------------------
# OAuth / OIDC (optional)
# ---------------------------------------------------------------------------
# Single generic OIDC provider via discovery (GitLab, Keycloak, Authentik,
# Google, Okta, ...). Disabled by default; when disabled, password login is
# unchanged. When enabled, OAUTH_ISSUER_URL/CLIENT_ID/CLIENT_SECRET are required
# and the server fails fast at startup if any is missing.
#
# Requires BASE_URL to use https:// in production so session/state cookies are
# marked Secure. Register the redirect URI below with your provider.

# Master switch. Accepts: 1/true/yes/on (else false).
# Default: false
# OAUTH_ENABLED=true

# Issuer base URL for OIDC discovery ({issuer}/.well-known/openid-configuration).
# OAUTH_ISSUER_URL=https://gitlab.com

# Application credentials registered with the provider.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# Redirect URI; must match the provider configuration.
# Default: {BASE_URL}/auth/oidc/callback
# OAUTH_REDIRECT_URL=https://errors.example.com/auth/oidc/callback

# Space-separated OAuth scopes.
# Default: openid email profile
# OAUTH_SCOPES=openid email profile

# Label shown on the SSO button ("Sign in with {name}").
# Default: SSO
# OAUTH_PROVIDER_NAME=GitLab

# Optional comma-separated whitelist of email domains allowed to auto-provision.
# Empty = any domain.
# OAUTH_ALLOWED_EMAIL_DOMAINS=example.com,itkey.com

# Example (GitLab.com):
#   OAUTH_ENABLED=true
#   OAUTH_ISSUER_URL=https://gitlab.com
#   OAUTH_CLIENT_ID=<from GitLab > User Settings > Applications>
#   OAUTH_CLIENT_SECRET=<from GitLab>
#   OAUTH_SCOPES=openid email profile
#   (Redirect URI in GitLab: {BASE_URL}/auth/oidc/callback)

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# tracing/env-filter directive controlling log verbosity.
# Default: info,soika=debug
RUST_LOG=info,soika=debug
